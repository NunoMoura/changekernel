{
  "format": {
    "enabled": false
  },
  "lsp": {
    "disabledServers": ["rust"],
    "servers": {
      "rust-toolchain": {
        "name": "rust-analyzer (pinned toolchain)",
        "extensions": [".rs"],
        "command": "rustup",
        "args": ["run", "1.88.0", "rust-analyzer"],
        "rootMarkers": ["Cargo.toml"]
      }
    },
    "serverOverrides": {
      "rust-toolchain": {
        "initializationOptions": {
          "cargo": {
            "allTargets": true,
            "buildScripts": { "enable": true }
          },
          "procMacro": { "enable": true },
          "diagnostics": {
            "enable": true,
            "experimental": { "enable": true }
          },
          "checkOnSave": true,
          "check": { "allTargets": true }
        }
      }
    }
  }
}
