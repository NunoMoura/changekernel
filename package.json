{
	"name": "@nunomoura/changekernel",
	"version": "0.5.0-prototype.1",
	"description": "Private source-development checks for the ChangeKernel referenced-intent Pi adapter.",
	"keywords": [
		"changekernel",
		"semantic-change",
		"state-containers",
		"procedural-memory",
		"governance"
	],
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit -p src/adapters/pi/referenced-intent/tsconfig.json",
		"test": "npm run typecheck && node --experimental-strip-types --test --test-concurrency=1 \"tests/adapters/pi/referenced-intent/*.test.mjs\""
	},
	"license": "MIT",
	"author": "Nuno Moura",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NunoMoura/changekernel.git"
	},
	"bugs": {
		"url": "https://github.com/NunoMoura/changekernel/issues"
	},
	"homepage": "https://github.com/NunoMoura/changekernel#readme",
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@earendil-works/pi-ai": "1.2.0",
		"@earendil-works/pi-tui": "1.2.0",
		"typebox": "1.3.27",
		"typescript": "5.9.3",
		"@types/node": "25.6.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"private": true
}
