{
	"name": "@nunomoura/codewiki",
	"version": "0.3.0",
	"description": "Project Server and bounded Runtime for accountable intent-to-production development with four Stage Loops, Checks, Gates, Knowledge, and Change Traces.",
	"keywords": [
		"documentation",
		"wiki",
		"llm",
		"agent",
		"okf",
		"pi-package"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./project-server": {
			"types": "./dist/project-server/index.d.ts",
			"import": "./dist/project-server/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js"
		},
		"./checks": {
			"types": "./dist/checks/index.d.ts",
			"import": "./dist/checks/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/clients/app/assets','dist/clients/app/assets',{recursive:true})\" && npm run build:dsh-runtime",
		"build:dsh-runtime": "node scripts/build-dsh-runtime.mjs",
		"dashboard:dev": "node --experimental-strip-types scripts/dashboard-dev.mjs",
		"prepack": "npm run build",
		"test": "npm run typecheck && npm run test:smoke",
		"test:smoke": "node --experimental-strip-types --test ./tests/scaffold-core.test.mjs ./tests/benchmarks/*.test.mjs ./tests/integration/*.test.mjs ./tests/changes/*.test.mjs ./tests/changes/trace/*.test.mjs ./tests/alignment/*.test.mjs ./tests/clients/**/*.test.mjs ./tests/project-server/*.test.mjs ./tests/project-server/**/*.test.mjs ./tests/plugins/*.test.mjs ./tests/protocol/*.test.mjs ./tests/evidence/*.test.mjs ./tests/checks/*.test.mjs ./tests/domains/*.test.mjs ./tests/runtime/*.test.mjs ./tests/runtime/checks/*.test.mjs ./tests/runtime/context/*.test.mjs ./tests/runtime/dsh/*.test.mjs ./tests/runtime/evidence/*.test.mjs ./tests/runtime/receipts/*.test.mjs ./tests/runtime/security/*.test.mjs ./tests/runtime/review/*.test.mjs ./tests/runtime/builds/*.test.mjs ./tests/runtime/processes/*.test.mjs ./tests/runtime/sandbox/*.test.mjs ./tests/checks/quality/*.test.mjs ./tests/loops/*.test.mjs ./tests/loops/decision/*.test.mjs ./tests/loops/planning/*.test.mjs ./tests/loops/implementation/*.test.mjs ./tests/knowledge/*.test.mjs ./tests/project/*.test.mjs ./tests/work-state/*.test.mjs",
		"test:features": "node --experimental-strip-types --test ./tests/benchmarks/*.test.mjs ./tests/integration/*.test.mjs ./tests/changes/*.test.mjs ./tests/changes/trace/*.test.mjs ./tests/alignment/*.test.mjs ./tests/clients/**/*.test.mjs ./tests/project-server/*.test.mjs ./tests/project-server/**/*.test.mjs ./tests/plugins/*.test.mjs ./tests/protocol/*.test.mjs ./tests/evidence/*.test.mjs ./tests/checks/*.test.mjs ./tests/domains/*.test.mjs ./tests/runtime/*.test.mjs ./tests/runtime/checks/*.test.mjs ./tests/runtime/context/*.test.mjs ./tests/runtime/dsh/*.test.mjs ./tests/runtime/evidence/*.test.mjs ./tests/runtime/receipts/*.test.mjs ./tests/runtime/security/*.test.mjs ./tests/runtime/review/*.test.mjs ./tests/runtime/builds/*.test.mjs ./tests/runtime/processes/*.test.mjs ./tests/runtime/sandbox/*.test.mjs ./tests/checks/quality/*.test.mjs ./tests/loops/*.test.mjs ./tests/loops/decision/*.test.mjs ./tests/loops/planning/*.test.mjs ./tests/loops/implementation/*.test.mjs ./tests/knowledge/*.test.mjs ./tests/project/*.test.mjs ./tests/work-state/*.test.mjs",
		"test:benchmarks": "node --experimental-strip-types --test ./tests/benchmarks/*.test.mjs",
		"test:pack": "npm pack --dry-run && node tests/project-server/package-install-smoke.mjs",
		"test:coordinator": "node --experimental-strip-types --test tests/project-server/project-coordinator.test.mjs tests/project-server/project-coordinator-events.test.mjs tests/project-server/implementation-worker-artifacts.test.mjs tests/project-server/workers/dispatch.test.mjs tests/project-server/integration/worker.test.mjs tests/project-server/project-branch-merge.test.mjs tests/project-server/project-branch-push.test.mjs tests/project-server/product-publication.test.mjs tests/project-server/product-release.test.mjs tests/project-server/workers/jobs.test.mjs tests/project-server/workbenches/container.test.mjs tests/project-server/project-coordinator-service.test.mjs tests/project-server/app/coordinator-client.test.mjs tests/project-server/project-coordinator-process.test.mjs tests/project-server/coordinator/reactions.test.mjs tests/clients/pi/project-service-client.test.mjs tests/project-server/coordinator/reactor.test.mjs tests/project-server/coordinator/executor.test.mjs",
		"test:pi-install": "node tests/clients/pi/install-smoke.mjs",
		"test:pi-rpc": "node tests/clients/pi/rpc-smoke.mjs",
		"test:pi-multiprocess": "node --experimental-strip-types tests/clients/pi/multiprocess-coordinator-smoke.mjs",
		"test:project-local-install": "node tests/project-server/project-local-install-smoke.mjs",
		"test:external-lifecycle": "node tests/project-server/external-package-lifecycle-smoke.mjs",
		"test:production": "node --experimental-strip-types --test tests/project-server/operations/observability.test.mjs tests/project-server/operations/reliability.test.mjs tests/project-server/operations/state.test.mjs tests/project-server/continuity/session.test.mjs tests/project-server/execution-recovery.test.mjs tests/project-server/integration/worker.test.mjs tests/project-server/project-branch-merge.test.mjs tests/project-server/project-branch-push.test.mjs tests/project-server/product-publication.test.mjs tests/project-server/product-release.test.mjs tests/runtime/production.test.mjs tests/runtime/runtime.test.mjs tests/runtime/builds/store.test.mjs tests/runtime/dsh/provider-host.test.mjs tests/runtime/dsh/private-provider-broker.test.mjs tests/runtime/dsh/secure-code-runtime.test.mjs tests/runtime/dsh/vertical-process.test.mjs tests/runtime/evidence/store.test.mjs tests/runtime/receipts/store.test.mjs tests/runtime/sandbox/bubblewrap.test.mjs tests/runtime/sandbox/run-process.test.mjs tests/runtime/security/collectors.test.mjs tests/runtime/security/scanners.test.mjs tests/benchmarks/*.test.mjs",
		"test:readiness": "node --experimental-strip-types --test tests/project-server/readiness-checklist.test.mjs",
		"audit:codewiki": "npm test && npm run test:production && npm run test:pack && npm run test:pi-install && npm run test:pi-rpc && npm run test:pi-multiprocess && npm run test:project-local-install && npm run test:external-lifecycle && npm run test:readiness && npm audit --omit=dev && git diff --check",
		"diagnostics:ratchet": "npm run build && node scripts/check-diagnostics-ratchet.mjs",
		"typecheck": "tsc --noEmit"
	},
	"license": "MIT",
	"author": "Nuno Moura",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NunoMoura/codewiki.git"
	},
	"bugs": {
		"url": "https://github.com/NunoMoura/codewiki/issues"
	},
	"homepage": "https://github.com/NunoMoura/codewiki#readme",
	"files": [
		"dist",
		"check-packs",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"package.json"
	],
	"devDependencies": {
		"@ast-grep/cli": "0.45.0",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/node": "25.6.0",
		"esbuild": "0.28.2",
		"jscpd": "3.5.10",
		"knip": "6.32.2",
		"madge": "8.0.0",
		"pi-lens": "4.1.1",
		"typebox": "^1.3.6",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"knip": {
		"entry": [
			"src/index.ts",
			"src/pi-extension.ts",
			"src/runtime/index.ts",
			"src/project-server/coordinator/daemon-process.ts",
			"src/runtime/processes/dsh-run-process.ts",
			"src/project-server/index.ts",
			"src/clients/pi/rendering/command-renderers.ts",
			"tests/**/*.mjs"
		],
		"project": [
			"src/**/*.ts",
			"benchmarks/**/*.ts",
			"tests/**/*.mjs"
		],
		"ignoreDependencies": []
	},
	"codewiki": {
		"checkPacks": [
			{
				"stage": "decision",
				"packId": "software-development-default",
				"path": "check-packs/decision/software-development-default"
			},
			{
				"stage": "planning",
				"packId": "software-development-default",
				"path": "check-packs/planning/software-development-default"
			},
			{
				"stage": "implementation",
				"packId": "software-development-default",
				"path": "check-packs/implementation/software-development-default"
			},
			{
				"stage": "review",
				"packId": "software-development-default",
				"path": "check-packs/review/software-development-default"
			}
		]
	},
	"pi": {
		"extensions": [
			"dist/pi-extension.js"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.10 <0.82.0 || 0.84.2",
		"typebox": "*"
	},
	"dependencies": {
		"@deepseek-ai/cordis": "4.0.1",
		"@deepseek-ai/cordis-plugin-loader": "1.0.2",
		"@deepseek-ai/dsh-agent": "0.1.1-rc.2",
		"@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
		"@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
		"@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
		"@deepseek-ai/dsh-authorization": "0.1.1-rc.2",
		"@deepseek-ai/dsh-brand": "0.1.1-rc.2",
		"@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
		"@deepseek-ai/dsh-commands": "0.1.1-rc.2",
		"@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
		"@deepseek-ai/dsh-compaction-basic": "0.1.1-rc.2",
		"@deepseek-ai/dsh-compaction-tool-result-pruner": "0.1.1-rc.2",
		"@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
		"@deepseek-ai/dsh-credentials-local": "0.1.1-rc.2",
		"@deepseek-ai/dsh-goal": "0.1.1-rc.2",
		"@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
		"@deepseek-ai/dsh-host-plugin-inventory": "0.1.1-rc.2",
		"@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
		"@deepseek-ai/dsh-launch-environment": "0.1.1-rc.2",
		"@deepseek-ai/dsh-llm": "0.1.1-rc.2",
		"@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
		"@deepseek-ai/dsh-llm-replay": "0.1.1-rc.2",
		"@deepseek-ai/dsh-scope": "0.1.1-rc.2",
		"@deepseek-ai/dsh-session": "0.1.1-rc.2",
		"@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
		"@deepseek-ai/dsh-session-persistence-jsonl": "0.1.1-rc.2",
		"@deepseek-ai/dsh-session-projection": "0.1.1-rc.2",
		"@deepseek-ai/dsh-settings": "0.1.1-rc.2",
		"@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
		"@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
		"@deepseek-ai/dsh-token-meter": "0.1.1-rc.2",
		"@deepseek-ai/dsh-tools": "0.1.1-rc.2",
		"@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
		"@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
		"@earendil-works/pi-ai": "0.82.1",
		"fast-xml-parser": "^5.10.1",
		"fast-xml-validator": "^1.4.1",
		"yaml": "^2.9.0"
	},
	"private": true,
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	}
}
